{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": {
    "singularName": "city",
    "pluralName": "cities",
    "displayName": "City / Town",
    "description": "A town within a district, used to narrow the agent search"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "district": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::district.district",
      "inversedBy": "cities"
    },
    "agents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::agent.agent",
      "mappedBy": "city"
    },
    "sortOrder": { "type": "integer", "default": 0 },
    "active": { "type": "boolean", "default": true }
  }
}

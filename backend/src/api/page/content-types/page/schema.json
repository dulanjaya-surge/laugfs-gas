{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "A composable page built from section blocks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.capabilities",
        "sections.energy",
        "sections.numbers",
        "sections.product",
        "sections.safety",
        "sections.maritime",
        "sections.story",
        "sections.investors",
        "sections.media",
        "sections.refill",
        "sections.company-intro",
        "sections.company-stats",
        "sections.company-reach",
        "sections.company-mission",
        "sections.company-values",
        "sections.company-timeline",
        "sections.company-group",
        "sections.company-recognition",
        "sections.company-commitment",
        "sections.company-governance",
        "sections.company-films",
        "sections.company-cta"
      ]
    }
  }
}

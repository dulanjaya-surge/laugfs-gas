{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Site-wide content shared on every page (nav, footer)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoOnDark": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "home.nav-link"
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "home.footer-column"
    },
    "footerAddress": {
      "type": "text"
    },
    "footerPhone": {
      "type": "string"
    },
    "footerFax": {
      "type": "string"
    }
  }
}

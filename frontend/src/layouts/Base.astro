---
import "../styles/global.css";
import Footer from "../components/sections/Footer.astro";
import { mediaUrl, mediaMime } from "../lib/strapi";

const { title, global, seo } = Astro.props;

const defaultSeo = global?.defaultSeo ?? {};
const FALLBACK_DESC =
  "LAUGFS Gas PLC supplies LP Gas across Sri Lanka and operates the largest LPG transshipment terminal in South Asia.";

const metaTitle = seo?.metaTitle || title || defaultSeo.metaTitle || "LAUGFS Gas";
const metaDescription = seo?.metaDescription || defaultSeo.metaDescription || FALLBACK_DESC;
const keywords = seo?.keywords || defaultSeo.keywords || "";
const shareImage = mediaUrl(seo?.shareImage ?? defaultSeo.shareImage, "");
// noindex defaults to true (site is not meant to be indexed yet)
const noindex = seo?.noindex ?? defaultSeo.noindex ?? true;

// Favicon comes from Global when set, otherwise the icon bundled in /public.
const faviconUrl = mediaUrl(global?.favicon, "/favicon.svg");
const faviconType = mediaMime(global?.favicon, "image/svg+xml");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,800;1,500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <div class="orb orb--gold"></div>
      <slot />
      <div class="wrap">
        <Footer global={global} />
      </div>
    </div>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>

---
import Base from "../layouts/Base.astro";
import "../styles/shop.css";
import { getGlobal } from "../lib/strapi";
import { getRefillData, money } from "../lib/shop";
import { splitAccent } from "../lib/content";

const [global, data] = await Promise.all([getGlobal(), getRefillData()]);
const { products, districts } = data;

const heading = splitAccent(data.pageTitle, data.pageAccent);

// Prices are the whole point of this page, so if the CMS is unreachable we say
// so plainly rather than render a price we cannot stand behind.
const ready = products.length > 0 && districts.length > 0;

const seo = {
  metaTitle: "Refill prices and authorised agents — LAUGFS Gas",
  metaDescription:
    "District-wise LP Gas refill prices for every cylinder size, and the authorised LAUGFS Gas agents nearest you.",
};
---

<Base title="Refill prices & agents" global={global} seo={seo}>
  {ready ? (
    <>
      <section class="refill">
        <div class="wrap">
          <div class="refill__intro">
            <span class="eyebrow">REFILL PRICES &amp; AUTHORISED AGENTS</span>
            <h1 class="refill__title">
              {heading.map((p) => (p.em ? <em>{p.t}</em> : p.t))}
            </h1>
            <p class="refill__lede">{data.pageIntro}</p>
          </div>

          <div class="locator" data-locator>
            <div class="locator__field">
              <label for="district">Your district</label>
              <div class="locator__select">
                <select id="district">
                  <option value="">Select district…</option>
                  {districts.map((d) => <option value={d.slug}>{d.name}</option>)}
                </select>
              </div>
            </div>
            <div class="locator__field">
              <label for="city">Your town</label>
              <div class="locator__select">
                <select id="city" disabled>
                  <option value="">All towns</option>
                </select>
              </div>
            </div>
            <p class="locator__status" data-locator-status role="status" aria-live="polite">
              Choose your district to see refill prices.
            </p>
          </div>
        </div>
      </section>

      <section class="sizes">
        <div class="wrap">
          <div class="sizes__grid">
            <div class="sizes__stage">
              <div class="sizes__glow"></div>
              {products.map((p, i) => (
                <img
                  class:list={["sizes__img", { "is-active": i === 0 }]}
                  data-img={p.slug}
                  src={p.image}
                  alt={p.imageAlt}
                  aria-hidden={i === 0 ? "false" : "true"}
                />
              ))}
              <span class="sizes__badge" data-weight-badge>{products[0]?.weightLabel}</span>
            </div>

            <div class="sizes__panel">
              <span class="sizes__label">Choose your cylinder</span>
              <div class="sizes__cards" role="radiogroup" aria-label="Cylinder size">
                {products.map((p, i) => (
                  <button
                    type="button"
                    class="sizecard"
                    role="radio"
                    data-size={p.slug}
                    aria-checked={i === 0 ? "true" : "false"}
                  >
                    <span class="sizecard__w">{p.weightLabel}</span>
                    <span class="sizecard__t">{p.tagline}</span>
                    <span class="sizecard__p" data-card-price={p.slug}>Select a district</span>
                  </button>
                ))}
              </div>

              <div class="sizes__detail">
                <div class="sizes__detailhead">
                  <h2 data-name>{products[0]?.name}</h2>
                  <div class="sizes__price">
                    <span class="sizes__amount" data-price>—</span>
                    <span class="sizes__per" data-price-for>refill price</span>
                  </div>
                </div>
                <p class="sizes__use" data-use>{products[0]?.useCase}</p>
                <p class="sizes__desc" data-desc>{products[0]?.description}</p>
                {data.priceNote && <p class="sizes__note">{data.priceNote}</p>}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="agents" id="agents">
        <div class="wrap">
          <div class="agents__head">
            <div>
              <span class="eyebrow">WHERE TO REFILL</span>
              <h2 data-agents-title>Authorised agents near you</h2>
              {data.agentNote && <p class="agents__note">{data.agentNote}</p>}
            </div>
            <span class="agents__count" data-agents-count hidden></span>
          </div>

          <p class="agents__state" data-agents-state>
            Select your district above to see the authorised agents nearest you.
          </p>
          <ul class="agents__list" data-agents-list></ul>

          <div class="agents__hotline">
            <div>
              <span class="agents__hotlabel">{data.hotlineLabel}</span>
              <a class="agents__hotnum" href={`tel:${data.supportPhone.replace(/\s/g, "")}`}>
                {data.supportPhone}
              </a>
            </div>
            <p>Our hotline can direct you to the closest authorised agent.</p>
          </div>
        </div>
      </section>

      <script type="application/json" id="refill-data" set:html={JSON.stringify(data)}></script>
      <script>
        import "../scripts/refill.ts";
      </script>
    </>
  ) : (
    <section class="shop-empty">
      <div class="wrap">
        <h1>Refill prices are unavailable</h1>
        <p>
          We could not load current prices. Please try again shortly, or call
          {" "}{data.supportPhone} and we will help you order a refill.
        </p>
        <a href="/" class="btn btn--soft">Back to the home page</a>
      </div>
    </section>
  )}
</Base>

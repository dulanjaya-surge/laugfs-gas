---
import { pick, arr } from "../../lib/content";

const { block } = Astro.props;

const heading = pick(block?.heading, "Media centre");
const cards = arr(block?.cards, [
  { tag: "INVESTOR", title: "Annual Report 2024/25 published", foot: "PDF" },
  { tag: "MEDIA RELEASE", title: "Latest company announcements and press coverage", foot: "MEDIA CENTRE" },
  { tag: "CONSUMER", title: "District-wise domestic refill price list", foot: "PRICES" },
]);
---

<div class="wrap">
  <section id="media" class="media">
    <div class="media__head reveal-group">
      <h2>{heading}</h2>
      <a href="#media" class="link-underline">ALL RELEASES →</a>
    </div>
    <div class="media__grid reveal-group">
      {cards.map((m) => (
        <a href="#media" class="media__card">
          <div class="media__tag">{m.tag}</div>
          <div class="media__title">{m.title}</div>
          <div class="media__foot">{m.foot}</div>
        </a>
      ))}
    </div>
  </section>
</div>
